theme_override_font_sizes/font_size = 50
text = "📄 What is Metadata?"

[node name="Explanation" type="RichTextLabel" parent="Panel2/MetdataPanel/ScrollContainer/VBoxContainer/Rule15"]
layout_mode = 2
size_flags_vertical = 3
theme_override_fonts/normal_font = ExtResource("4_uhe4a")
theme_override_font_sizes/normal_font_size = 35
theme_override_styles/normal = SubResource("StyleBoxEmpty_ssqnt")
text = "☉ Metadata is information that describes a file or digital content. It provides details such as the file name, extension, source, publisher, size, and permissions."
fit_content = true
scroll_active = false
autowrap_mode = 2
horizontal_alignment = 3
justification_flags = 161

[node name="Tip" type="RichTextLabel" parent="Panel2/MetdataPanel/ScrollContainer/VBoxContainer/Rule15"]
layout_mode = 2
size_flags_vertical = 3
theme_override_fonts/normal_font = ExtResource("4_uhe4a")
theme_override_font_sizes/normal_font_size = 35
theme_override_styles/normal = SubResource("StyleBoxEmpty_ssqnt")
text = "☉ Tip: In cybersecurity, metadata is commonly analyzed to identify suspicious behavior and detect potential threats before opening or executing a file."
fit_content = true
scroll_active = false
autowrap_mode = 2
horizontal_alignment = 3

[node name="Rule16" type="VBoxContainer" parent="Panel2/MetdataPanel/ScrollContainer/VBoxContainer"]
layout_mode = 2
