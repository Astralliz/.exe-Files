theme_override_fonts/normal_font = ExtResource("4_uhe4a")
theme_override_font_sizes/normal_font_size = 35
theme_override_styles/normal = SubResource("StyleBoxEmpty_ssqnt")
text = "☉ A file named “invoice.pdf.exe” may appear harmless at first glance, but its metadata reveals that it is actually an executable program disguised as a PDF document.	"
fit_content = true
