theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Panel2/MetdataPanel/ScrollContainer/VBoxContainer/Rule16"]
layout_mode = 2
theme_override_fonts/font = ExtResource("4_uhe4a")
theme_override_font_sizes/font_size = 50
text = "📌 Why Metadata Matters"

[node name="Explanation" type="RichTextLabel" parent="Panel2/MetdataPanel/ScrollContainer/VBoxContainer/Rule16"]
layout_mode = 2
size_flags_vertical = 3
theme_override_fonts/normal_font = ExtResource("4_uhe4a")
theme_override_font_sizes/normal_font_size = 35
theme_override_styles/normal = SubResource("StyleBoxEmpty_ssqnt")
text = "☉ Cybercriminals often manipulate file metadata to disguise malicious files as legitimate software or documents. By examining metadata indicators, users can identify warning signs that may indicate malware, phishing attempts, trojans, or other cyber threats."
fit_content = true
scroll_active = false
autowrap_mode = 2
horizontal_alignment = 3
justification_flags = 161

[node name="Rule17" type="VBoxContainer" parent="Panel2/MetdataPanel/ScrollContainer/VBoxContainer"]
